{
  "name": "report-desk",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "tsx scripts/setup.ts",
    "migrate": "tsx scripts/migrate.ts",
    "check:db": "tsx scripts/check-db.ts",
    "test:integration": "tsx --env-file=.env scripts/verify-domain.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "exceljs": "4.4.0",
    "mongodb": "7.7.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
